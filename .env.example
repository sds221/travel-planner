# ── 数据库 ───────────────────────────────────────────────────────────
# 端口用 5433/6380 避开本机可能已有的 Postgres/Redis
DATABASE_URL=postgresql://travel:travel@localhost:5433/travel_planner
REDIS_URL=redis://localhost:6380

# ── LLM(OpenAI 兼容接口) ─────────────────────────────────────────────
# DeepSeek: https://platform.deepseek.com  → base URL https://api.deepseek.com/v1, model deepseek-chat
# 阿里通义:  https://dashscope.aliyuncs.com/compatible-mode/v1, model qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── 高德地图 ─────────────────────────────────────────────────────────
# 控制台 https://console.amap.com/dev/key/app
# 需要两个 key：Web 服务(后端 POI/路径规划) + Web 端 JS(前端渲染)
AMAP_SERVER_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
# JS API 2.0 起必须配安全密钥，与 JS key 成对下发
NEXT_PUBLIC_AMAP_JS_SECURITY_CODE=

# ── 房价查询(火山方舟/豆包) ──────────────────────────────────────────
# 只有方舟的 Responses API 有内置 web_search 工具，能真正联网查当前房价。
# DeepSeek 的 API 没有联网能力(联网只在网页版/App)，所以查价单独配一份凭据。
# 控制台 https://console.volcengine.com/ark → 开通推理接入点后拿 API Key
#
# 不配也能跑：会退回让主模型凭市场行情估价(标注"行情估价")，
# 再不行退回星级×品牌×城市系数推算(标注"粗估价")。
ARK_API_KEY=
# 推理接入点 ID(ep-xxx)或模型名
ARK_MODEL=doubao-seed-1-6-250615

# 查价策略：auto=配了 ARK 就联网查，否则模型估价
#   search  = 只用联网查价(查不到就没有价格)
#   llm     = 只用模型行情估价，不联网
#   formula = 只用系数推算，完全离线、不烧 token
PRICE_MODE=auto
